# This project doesn't use a single shared .env - each app/package reads its
# own .env file (because they're meant to run as separate services, possibly
# on separate machines/regions eventually). Copy this file to each of:
#
#   packages/db/.env
#   apps/backend/.env
#   apps/worker/.env
#   apps/pusher/.env
#
# and fill in what that one needs (see the per-app .env.example files for the
# exact list - most only need DATABASE_URL).
#
# If you're using the included docker-compose.yml (docker compose up -d),
# these defaults already match it.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uptime?schema=public"
